@model EmprendeLeonWeb.Models.Emprendedor
@{
    ViewData["Title"] = "Registrar negocio";
}

<div class="container panel-container">
    <div class="panel-header">🏪 Registrar mi negocio</div>

    <form asp-action="RegistrarNegocio" method="post">
        <div class="mb-3">
            <label asp-for="NombreNegocio" class="form-label">Nombre del negocio</label>
            <input asp-for="NombreNegocio" class="form-control" required />
            <span asp-validation-for="NombreNegocio" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripcion</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Ubicacion" class="form-label">Ubicacion</label>
            <input asp-for="Ubicacion" class="form-control" />
            <span asp-validation-for="Ubicacion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Contacto" class="form-label">Correo o telefono</label>
            <input asp-for="Contacto" class="form-control" />
            <span asp-validation-for="Contacto" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Categoria" class="form-label">Categoria</label>
            <select asp-for="Categoria" class="form-select">
                <option value="General">General</option>
                <option value="Artesanias">Artesanias</option>
                <option value="Cafe y reposteria">Cafe y reposteria</option>
                <option value="Moda ecologica">Moda ecologica</option>
                <option value="Tecnologia">Tecnologia</option>
                <option value="Servicios">Servicios</option>
            </select>
            <span asp-validation-for="Categoria" class="text-danger"></span>
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Registrar negocio</button>
        </div>
    </form>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info mt-4 text-center">
            @TempData["Mensaje"]
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}