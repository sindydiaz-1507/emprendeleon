@model EmprendeLeonWeb.Models.ViewModels.PerfilNegocioViewModel
@{
    ViewData["Title"] = "Perfil del negocio";
}

<div class="container mt-4">
    <h2>@Model.NombreNegocio</h2>
    <p><strong>Categoría:</strong> @Model.Categoria</p>
    <p><strong>Descripción:</strong> @Model.Descripcion</p>

    @if (!string.IsNullOrEmpty(Model.Ubicacion))
    {
        <p><strong>Dirección:</strong> @Model.Ubicacion</p>
    }

    @if (!string.IsNullOrEmpty(Model.Contacto))
    {
        <p><strong>WhatsApp:</strong> 
            <a href="https://wa.me/@Model.Contacto" target="_blank">@Model.Contacto</a>
        </p>
    }

    <h3 class="mt-4">🛍️ Productos disponibles</h3>

    @if (Model.Productos.Any())
    {
        <div class="row">
            @foreach (var producto in Model.Productos)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="@producto.Imagen" class="card-img-top" alt="@producto.Nombre" />
                        <div class="card-body">
                            <h5 class="card-title">@producto.Nombre</h5>
                            <p class="card-text">@producto.Descripcion</p>
                            <p><strong>Precio:</strong> C$@producto.Precio</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>No hay productos disponibles en este momento.</p>
    }
</div>