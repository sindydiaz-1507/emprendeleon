@model Dictionary<string, List<EmprendeLeonWeb.Models.Emprendedor>>
@{
    ViewData["Title"] = "Explorar negocios";
    var busqueda = ViewBag.Busqueda as string ?? "";
}

<div class="container mt-4">
    <h2 class="mb-4">🛍️ Catálogo de negocios</h2>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="busqueda" class="form-control" placeholder="Buscar por nombre, categoría o descripción" value="@busqueda" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No hay negocios disponibles que coincidan con tu búsqueda.</div>
    }
    else
    {
        foreach (var grupo in Model)
        {
            <h4 class="mt-4">@grupo.Key</h4>
            <div class="row">
                @foreach (var negocio in grupo.Value)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm border-primary">
                            <div class="card-body">
                                <h5 class="card-title">@negocio.NombreNegocio</h5>
                                <p class="card-text">@negocio.Descripcion</p>

                                <p>
                                    <span class="badge bg-info text-dark">📍 @negocio.Ubicacion</span>
                                    <span class="badge bg-secondary">📞 @negocio.Contacto</span>
                                </p>

                                <p class="text-muted">
                                    @negocio.Productos?.Count() productos disponibles
                                </p>

                                <a class="btn btn-outline-primary w-100"
                                   asp-controller="Cliente"
                                   asp-action="ProductosPorNegocio"
                                   asp-route-id="@negocio.IdEmprendedor">
                                   Ver productos
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>